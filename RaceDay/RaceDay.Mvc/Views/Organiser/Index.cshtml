@model List<RaceDay.Contracts.EventDto>
@{ ViewData["Title"] = "Dashboard"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Welcome, @ViewBag.DisplayName</h2>
    <a asp-action="CreateEvent" class="btn btn-success">+ Create New Event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Your Upcoming Events</h5>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <p class="text-muted">You haven't created any events yet.</p>
                }
                else
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Distance</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evt in Model)
                            {
                                <tr>
                                    <td>@evt.Name</td>
                                    <td>@evt.EventDate.ToString("dd MMM yyyy")</td>
                                    <td>@evt.Location</td>
                                    <td>@evt.DistanceKm km</td>
                                    <td>
                                        <a asp-action="EditEvent" asp-route-id="@evt.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>