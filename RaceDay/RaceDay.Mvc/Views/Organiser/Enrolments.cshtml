@model List<RaceDay.Contracts.EnrolmentDto>
@{ ViewData["Title"] = "View Enrolments"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Enrolments for <span class="text-primary">@ViewBag.EventName</span></h2>
    <a asp-action="Events" class="btn btn-secondary">Back to Events</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead class="table-dark">
                <tr><th>Participant</th><th>Email</th><th>Category</th><th>Status</th><th>Update Status</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.ParticipantName</td>
                        <td>@e.EventName</td> <!-- Reusing DTO fields for view -->
                        <td>@e.CategoryName</td>
                        <td>
                            @if (e.Status == "Confirmed") { <span class="badge bg-success">Confirmed</span> }
                            else if (e.Status == "Pending") { <span class="badge bg-warning text-dark">Pending</span> }
                            else { <span class="badge bg-secondary">@e.Status</span> }
                        </td>
                        <td>
                            <form asp-action="UpdateEnrolmentStatus" asp-route-eventId="@ViewBag.EventId" method="post" class="d-flex gap-1">
                                <input type="hidden" name="id" value="@e.EnrolmentId" />
                                <select name="status" class="form-select form-select-sm" style="width:120px;">
                                    <option value="Pending">Pending</option>
                                    <option value="Confirmed">Confirmed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>