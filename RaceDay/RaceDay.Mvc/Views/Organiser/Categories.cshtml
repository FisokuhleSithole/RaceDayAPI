@model List<RaceDay.Contracts.CategoryDto>
@{ ViewData["Title"] = "Manage Categories"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categories for <span class="text-primary">@ViewBag.EventName</span></h2>
    <a asp-action="Events" class="btn btn-secondary">Back to Events</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white"><h5 class="mb-0">Add Category</h5></div>
            <div class="card-body">
                <form asp-action="CreateCategory" asp-route-eventId="@ViewBag.EventId" method="post">
                    <div class="mb-2"><label class="form-label">Name</label><input name="name" class="form-control" required placeholder="e.g., 10km, Senior" /></div>
                    <div class="mb-2"><label class="form-label">Description</label><input name="description" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">Entry Fee (R)</label><input name="entryFee" type="number" step="0.01" class="form-control" required /></div>
                    <button type="submit" class="btn btn-success w-100">Add Category</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead class="table-dark"><tr><th>Name</th><th>Description</th><th>Fee</th></tr></thead>
                    <tbody>
                        @if(Model != null && Model.Any()) {
                            foreach (var c in Model)
                            {
                                <tr><td class="fw-bold">@c.Name</td><td>@c.Description</td><td>R @c.EntryFee.ToString("F2")</td></tr>
                            }
                        } else {
                            <tr><td colspan="3" class="text-center text-muted">No categories yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>