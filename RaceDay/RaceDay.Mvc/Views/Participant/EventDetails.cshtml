@model RaceDay.Contracts.EventDto
@{ ViewData["Title"] = Model.Name; }
@{
    var categories = ViewBag.Categories as List<RaceDay.Contracts.CategoryDto> ?? new List<RaceDay.Contracts.CategoryDto>();
}

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

@inject IConfiguration Configuration
...
@if (!string.IsNullOrEmpty(Model.BannerImageUrl))
{
    <img src="@(Configuration["ApiSettings:BaseUrl"].TrimEnd('/'))@Model.BannerImageUrl" alt="Event Banner" class="img-fluid rounded mb-3" style="max-height: 300px; width: 100%; object-fit: cover;" />
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h1 class="fw-bold mb-1">@Model.Name</h1>
                <span class="badge bg-primary fs-6">@Model.EventType</span>
            </div>
            <a asp-action="Index" class="btn btn-secondary">Back to Events</a>
        </div>
        
        <hr />
        
        <div class="row mt-4">
            <div class="col-md-8">
                <p class="fs-5">@Model.Description</p>
                <ul class="list-unstyled fs-5 mt-4">
                    <li class="mb-2"> <strong>Date:</strong> @Model.EventDate.ToString("dddd, dd MMMM yyyy")</li>
                    <li class="mb-2"> <strong>Location:</strong> @Model.Location</li>
                    <li class="mb-2"> <strong>Distance:</strong> @Model.DistanceKm km</li>
                    <li class="mb-2"> <strong>Max Participants:</strong> @(Model.MaxParticipants?.ToString() ?? "No limit")</li>
                </ul>
            </div>
            <div class="col-md-4">
                <div class="card bg-light border-0">
                    <div class="card-body">
                        <h4 class="mb-3 text-center">Enter Event</h4>
                        @if (!categories.Any())
                        {
                            <p class="text-muted text-center">No categories available yet.</p>
                        }
                        else
                        {
                            <form asp-action="EnterEvent" method="post">
                                <input type="hidden" name="eventId" value="@Model.EventId" />
                                
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Select Category</label>
                                    <select name="categoryId" class="form-select" required>
                                        <option value="">-- Choose a category --</option>
                                        @foreach (var cat in categories)
                                        {
                                            <option value="@cat.CategoryId">@cat.Name (R @cat.EntryFee.ToString("F2"))</option>
                                        }
                                    </select>
                                </div>
                                
                                <button type="submit" class="btn btn-success w-100 btn-lg">Enrol Now</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>